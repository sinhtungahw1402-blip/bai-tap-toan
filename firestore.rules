rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // QUY TẮC BẢO MẬT FIREBASE FIRESTORE - AZOTA TOÁN
    // Cho phép học sinh trên toàn trường làm bài và quản trị viên quản lý đồng bộ
    // =========================================================================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
